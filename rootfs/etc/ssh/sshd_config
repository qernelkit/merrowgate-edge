# /etc/ssh/sshd_config: field-engineer bastion on the edge gateway.
# Engineers sign in as "fieldops" with a short-lived certificate from the field engineering CA, issued
# for one shift with the principal fieldops. No passwords, no long-lived keys, no root.

Port 2222
AddressFamily inet
PidFile /run/sshd.pid

HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_rsa_key

KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,curve25519-sha256
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
HostKeyAlgorithms ssh-ed25519,ecdsa-sha2-nistp256,rsa-sha2-512

# User authentication: certificates only.
PubkeyAcceptedAlgorithms ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,ecdsa-sha2-nistp256
RequiredRSASize 3072
MaxAuthTries 3
TrustedUserCAKeys /etc/ssh/engineer_ca.pub
AuthorizedKeysFile none
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
AllowUsers fieldops
LoginGraceTime 30
MaxSessions 4

# A bastion: engineers forward to depot devices, nothing else.
AllowTcpForwarding local
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
ClientAliveInterval 120
ClientAliveCountMax 3

# Logs the certificate's key id and serial for every sign-in.
LogLevel VERBOSE
SyslogFacility AUTH

Subsystem sftp internal-sftp
